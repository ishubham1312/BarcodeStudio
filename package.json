{
  "name": "barcode-studio-v3",
  "private": true,
  "version": "3.7.1",
  "type": "module",
  "description": "Barcode Studio is a desktop application for designing, printing and managing barcodes.",
  "author": "Shubham",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js dist-electron dist-desktop",
    "lint": "tsc --noEmit",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=dist-electron/main.cjs --packages=external && esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --packages=external",
    "build:python": "node scripts/build-python.js",
    "electron:dev": "npm run build:electron && concurrently -k -s first \"npm run dev\" \"wait-on http://127.0.0.1:3000 && node_modules\\electron\\dist\\electron.exe .\"",
    "electron:build": "npm run build && npm run build:electron && npm run build:python",
    "electron:package": "npm run electron:build && electron-builder build --win"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.18.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mssql": "^12.6.0",
    "mysql2": "^3.22.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sqlite3": "^6.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.0.10"
  }
}